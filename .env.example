# ==========================================
# DocuMind - Root Environment Configuration
# ==========================================

# Application
PROJECT_NAME="DocuMind"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-at-least-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for external credentials (e.g. GitHub PATs) - 32 url-safe base64-encoded bytes
ENCRYPTION_KEY="replace-with-a-fernet-compatible-base64-key="

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=documind_password
POSTGRES_DB=documind_db
DATABASE_URL=postgresql+asyncpg://documind_user:documind_password@localhost:5432/documind_db

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=documind_code_chunks

# Redis (Cache & Task Queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# GitHub Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Providers (LLM & Embeddings)
# You can set an OpenAI key OR an Anthropic key OR use local Ollama
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL_NAME="BAAI/bge-base-en-v1.5"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
