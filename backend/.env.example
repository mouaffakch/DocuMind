# Backend Local Configuration
PROJECT_NAME="DocuMind"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Security (Generate with: openssl rand -hex 32)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-at-least-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Key for encrypting external secrets like GitHub PATs (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="replace-with-a-fernet-compatible-base64-key="

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=documind_password
POSTGRES_DB=documind_db
DATABASE_URL=postgresql+asyncpg://documind_user:documind_password@localhost:5432/documind_db
SYNC_DATABASE_URL=postgresql://documind_user:documind_password@localhost:5432/documind_db

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=documind_code_chunks

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL_NAME="BAAI/bge-base-en-v1.5"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
